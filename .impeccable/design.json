    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Every primary action; the only filled violet control.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Become a partner</button>",
      "css": ".ds-btn{font-family:var(--bs-font-sans);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 20px;border-radius:var(--bs-radius-md);border:1px solid transparent;font-size:14px;font-weight:600;line-height:1;white-space:nowrap;cursor:pointer;transition:background 120ms cubic-bezier(0.16,1,0.3,1),border-color 120ms cubic-bezier(0.16,1,0.3,1),transform 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(124,92,255,.35)}.ds-btn-primary{background:var(--bs-accent-fill);color:#fff}.ds-btn-primary:hover{background:var(--bs-accent-hover)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Second action beside a primary.",
      "html": "<button class=\"ds-btn-secondary\">View order</button>",
      "css": ".ds-btn-secondary{font-family:var(--bs-font-sans);display:inline-flex;align-items:center;height:48px;padding:0 20px;border-radius:var(--bs-radius-md);border:1px solid var(--bs-border-default);background:var(--bs-bg-card);color:var(--bs-text-primary);font-size:14px;font-weight:600;cursor:pointer;transition:background 120ms,border-color 120ms}.ds-btn-secondary:hover{background:var(--bs-bg-elevated);border-color:var(--bs-border-strong)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(124,92,255,.35)}"
    },
    {
