      "description": "App form field.",
      "html": "<input class=\"ds-input\" placeholder=\"Email address\" />",
      "css": ".ds-input{font-family:var(--bs-font-sans);width:100%;height:48px;padding:0 14px;border-radius:var(--bs-radius-md);border:1px solid var(--bs-border-default);background:var(--bs-bg-input);color:var(--bs-text-primary);font-size:15px;transition:border-color 120ms,box-shadow 120ms}.ds-input::placeholder{color:var(--bs-text-muted)}.ds-input:hover{border-color:var(--bs-border-strong)}.ds-input:focus{outline:none;border-color:var(--bs-accent);box-shadow:0 0 0 3px rgba(124,92,255,.35)}"
    },
    {
