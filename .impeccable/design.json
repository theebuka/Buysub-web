      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis actions in toolbars and menus.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{font-family:var(--bs-font-sans);display:inline-flex;align-items:center;height:48px;padding:0 20px;border-radius:var(--bs-radius-md);border:1px solid transparent;background:transparent;color:var(--bs-text-secondary);font-size:14px;font-weight:600;cursor:pointer;transition:background 120ms,color 120ms}.ds-btn-ghost:hover{background:var(--bs-bg-elevated);color:var(--bs-text-primary)}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(124,92,255,.35)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
