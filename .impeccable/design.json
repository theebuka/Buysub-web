      "description": "Outlined count tag on home category cards.",
      "html": "<span class=\"ds-tag\">12 products</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:28px;padding:0 8px;border:1px solid var(--bs-border-strong);border-radius:4px;font-family:var(--bs-font-sans);font-size:13px;color:var(--bs-text-primary)}"
    },
    {
      "name": "App Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Default container across app surfaces.",
      "html": "<div class=\"ds-card\"><strong>Wallet</strong><p>₦12,500 available</p></div>",
      "css": ".ds-card{background:var(--bs-bg-card);border:1px solid var(--bs-border-default);border-radius:var(--bs-radius-xl);padding:20px;font-family:var(--bs-font-sans);color:var(--bs-text-primary);transition:border-color 120ms}.ds-card:hover{border-color:var(--bs-border-strong)}.ds-card p{color:var(--bs-text-secondary);font-size:14px;margin-top:4px}"
    },
    {
      "name": "Home Category Card",
      "kind": "card",
      "refersTo": "home-category-card",
      "description": "Browse-by-category card on the home page: 2:1 media over a muted body.",
      "html": "<a class=\"ds-cat\" href=\"#\"><span class=\"ds-cat-media\"><span class=\"ds-logo\" style=\"background:#E50914\"></span><span class=\"ds-logo\" style=\"background:#1ED760\"></span><span class=\"ds-logo\" style=\"background:#FF0000\"></span></span><span class=\"ds-cat-body\"><span class=\"ds-cat-name\">Streaming</span><span class=\"ds-cat-foot\"><span class=\"ds-tag\">12 products</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></span></a>",
      "css": ".ds-cat{display:flex;flex-direction:column;width:300px;border-radius:var(--bs-radius-md);overflow:hidden;background:var(--bs-bg-muted);color:var(--bs-text-primary);text-decoration:none}.ds-cat:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(124,92,255,.35)}.ds-cat-media{aspect-ratio:2/1;display:flex;align-items:center;justify-content:center;background:var(--bs-bg-elevated);border-bottom:1px solid var(--bs-border-default)}.ds-logo{width:64px;height:64px;border-radius:16px;box-shadow:0 10px 24px -14px rgba(10,10,20,.5),0 0 0 3px var(--bs-bg-elevated);transition:transform .6s cubic-bezier(.16,1,.3,1)}.ds-logo+.ds-logo{margin-left:-20px}.ds-logo:nth-child(1){transform:rotate(-8deg) translateY(4px)}.ds-logo:nth-child(3){transform:rotate(8deg) translateY(4px)}.ds-cat:hover .ds-logo:nth-child(1){transform:rotate(-14deg) translate(-10px,2px)}.ds-cat:hover .ds-logo:nth-child(3){transform:rotate(14deg) translate(10px,2px)}.ds-cat-body{display:flex;flex-direction:column;gap:32px;padding:20px}.ds-cat-name{font-family:'Geist',var(--bs-font-sans);font-size:24px;font-weight:500;letter-spacing:-.02em;line-height:1.15}.ds-cat-foot{display:flex;align-items:center;justify-content:space-between;color:var(--bs-text-secondary)}.ds-tag{display:inline-flex;align-items:center;height:28px;padding:0 8px;border:1px solid var(--bs-border-strong);border-radius:4px;font-family:var(--bs-font-sans);font-size:13px;color:var(--bs-text-primary)}"
    },
    {
      "name": "Brand Tile",
      "kind": "custom",
      "refersTo": "home-brand-tile",
      "description": "Marquee tile: the service's official colour with a white Simple Icons glyph.",
      "html": "<a class=\"ds-brand\" href=\"#\"><span class=\"ds-brand-tile\" style=\"background:#E50914\"><svg viewBox=\"-1 -1 26 26\"><path fill=\"#fff\" d=\"m5.398 0 8.348 23.602c2.346.059 4.856.398 4.856.398L10.113 0H5.398zm8.489 0v9.172l4.715 13.33V0h-4.715zM5.398 1.5V24c1.873-.225 2.81-.312 4.715-.398V14.83L5.398 1.5z\"/></svg></span><span class=\"ds-brand-name\">Netflix</span></a>",
      "css": ".ds-brand{display:flex;flex-direction:column;align-items:center;gap:12px;width:120px;color:var(--bs-text-secondary);text-decoration:none;font-family:var(--bs-font-sans)}.ds-brand-tile{display:grid;place-items:center;width:120px;height:120px;border-radius:28px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);transition:transform .5s cubic-bezier(.16,1,.3,1)}.ds-brand-tile svg{width:54px;height:54px}.ds-brand:hover .ds-brand-tile{transform:translateY(-4px) rotate(-3deg)}.ds-brand:focus-visible{outline:none}.ds-brand:focus-visible .ds-brand-tile{box-shadow:0 0 0 3px rgba(124,92,255,.35)}.ds-brand-name{font-size:13px;font-weight:500}"
    },
    {
      "name": "Site Header",
      "kind": "nav",
      "refersTo": "",
      "description": "Sticky 64px header with a frosted page-ground fill and a 1px rule.",
      "html": "<header class=\"ds-header\"><span class=\"ds-logo-word\">BuySub</span><nav class=\"ds-nav\"><button class=\"ds-nav-btn\" aria-expanded=\"true\">Browse</button><button class=\"ds-nav-btn\">Help</button></nav></header>",
      "css": ".ds-header{display:flex;align-items:center;gap:16px;height:64px;padding:0 24px;background:color-mix(in srgb,var(--bs-bg-base) 88%,transparent);backdrop-filter:saturate(160%) blur(12px);border-bottom:1px solid var(--bs-border-default);color:var(--bs-text-primary);font-family:var(--bs-font-sans)}.ds-logo-word{font-size:17px;font-weight:700;letter-spacing:-.01em}.ds-nav{display:flex}.ds-nav-btn{font-family:inherit;height:40px;padding:0 12px;border:0;border-radius:var(--bs-radius-md);background:transparent;color:var(--bs-text-secondary);font-size:13px;font-weight:600;cursor:pointer}.ds-nav-btn:hover,.ds-nav-btn[aria-expanded=true]{background:var(--bs-bg-elevated);color:var(--bs-text-primary)}.ds-nav-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(124,92,255,.35)}"
    }
